{
    "name": "personal-context-studio",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --experimental-strip-types apps/api/src/server.ts",
        "dev:watcher": "node --experimental-strip-types apps/watcher/src/main.ts",
        "dev:supervisor": "node --experimental-strip-types apps/supervisor/src/main.ts",
        "mcp": "node --experimental-strip-types apps/mcp/src/main.ts",
        "cli": "node --experimental-strip-types apps/cli/src/main.ts",
        "adapter": "node --experimental-strip-types apps/cli/src/main.ts adapter",
        "pcs:doctor": "node --experimental-strip-types apps/cli/src/main.ts integration doctor",
        "crypto:rekey": "node --experimental-strip-types scripts/rekey-encryption.mjs",
        "ops:diagnostics": "node scripts/ops-diagnostics.mjs",
        "db:diagnostics": "node scripts/db-diagnostics.mjs",
        "db:backup-retention": "node scripts/plan-backup-retention.mjs",
        "db:verify-backup": "node scripts/verify-backup.mjs",
        "ops:watch": "node scripts/ops-watch.mjs",
        "check:packaging": "node scripts/check-packaging.mjs",
        "test": "node --experimental-strip-types --test test/*.test.ts",
        "test:sensitivity-quality": "node --experimental-strip-types --test test/auto-confirm-evaluation.test.ts",
        "test:e2e": "node --experimental-strip-types --test test/e2e/browser-e2e.test.ts",
        "typecheck": "tsc --project tsconfig.json",
        "check:encoding": "node scripts/check-encoding.mjs",
        "check:migrations": "node --experimental-strip-types scripts/check-migrations.mjs",
        "evaluate:auto-confirm": "node --experimental-strip-types tools/evaluate-auto-confirm.ts",
        "calibrate:auto-confirm": "node --experimental-strip-types tools/calibrate-auto-confirm.ts",
        "build:external-auto-confirm-eval": "node --experimental-strip-types tools/build-external-auto-confirm-eval.ts",
        "build:japanese-semantic-eval": "node --experimental-strip-types tools/build-japanese-semantic-eval.ts",
        "build:japanese-context-span-eval": "node --experimental-strip-types tools/build-japanese-context-span-eval.ts",
    "evaluate:gliner-context-span": "node --experimental-strip-types tools/evaluate-gliner-context-span.ts",
    "compare:gliner-context-span": "node --experimental-strip-types tools/compare-gliner-context-span.ts",
    "build:japanese-name-dictionary": "node --experimental-strip-types tools/build-japanese-name-dictionary.ts",
        "evaluate:external-auto-confirm": "node --experimental-strip-types tools/evaluate-external-auto-confirm-eval.ts",
        "calibrate:external-semantic": "node --experimental-strip-types tools/calibrate-external-semantic-grouped.ts",
        "build:secret-eval": "node --experimental-strip-types tools/build-secret-eval.ts",
        "evaluate:secret": "node --experimental-strip-types tools/evaluate-secret-eval.ts",
        "verify": "npm run build:contracts && npm run build:integration-doctor && npm run typecheck && npm run test && npm run check:migrations && npm run check:encoding",
        "verify:ci": "npm ci && npm run verify",
        "prepare": "npm run build:contracts && npm run build:integration-doctor",
        "build:contracts": "tsc packages/integration-contracts/src/index.ts --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck --declaration --outDir packages/integration-contracts/dist",
        "build:integration-doctor": "npm run build:contracts && tsc packages/integration-doctor/src/index.ts --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck --declaration --rewriteRelativeImportExtensions --outDir packages/integration-doctor/dist"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "playwright": "^1.62.1",
        "typescript": "^5.8.3"
    },
    "exports": {
        ".": "./README.md",
        "./integration-contracts": "./packages/integration-contracts/dist/index.js",
        "./integration-doctor": "./packages/integration-doctor/dist/index.js"
    },
    "files": [
        "packages/integration-contracts/dist",
        "packages/integration-contracts/package.json",
        "packages/integration-doctor/dist",
        "packages/integration-doctor/package.json",
        "README.md"
    ],
    "version": "1.0.0",
    "description": "The current product contract is [docs/current-product-spec.md](docs/current-product-spec.md). The release scope decision is [docs/spec/v1-scope.md](docs/spec/v1-scope.md). Architecture decisions are recorded in [docs/adr](docs/adr) and the main usability notes are in [docs/usability-findings.md](docs/usability-findings.md).",
    "main": "index.js",
    "directories": {
        "doc": "docs",
        "test": "test"
    },
    "dependencies": {
        "@huggingface/transformers": "^4.2.0",
        "playwright-core": "^1.62.1",
        "undici-types": "^7.8.0"
    },
    "overrides": {
        "sharp": "^0.35.2",
        "adm-zip": "^0.6.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jinghaodao-tech/Personal-Context-Studio.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/jinghaodao-tech/Personal-Context-Studio/issues"
    },
    "homepage": "https://github.com/jinghaodao-tech/Personal-Context-Studio#readme"
}
